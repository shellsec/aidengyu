{
  "name": "codex-claude-signal-windows",
  "version": "0.4.1",
  "description": "Codex, Claude Code, and Cursor status light for Windows",
  "main": "main.js",
  "author": "Codex Claude Signal",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "make-icon": "node scripts/make-icon.js",
    "pack:win": "electron-packager . \"Codex Claude Signal\" --platform=win32 --arch=x64 --out=../dist-windows --overwrite --asar --prune=true --icon=assets/app.ico --ignore=tests --ignore=scripts"
  },
  "devDependencies": {
    "@electron/packager": "18.3.6",
    "electron": "35.7.5",
    "png-to-ico": "2.1.8",
    "sharp": "0.34.3"
  }
}
